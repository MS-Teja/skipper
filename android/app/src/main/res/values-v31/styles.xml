<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the app background colour (follows dark mode
         through values-night/colors.xml). -->
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:colorBackground">@color/app_bg</item>
        <item name="android:windowSplashScreenBackground">@color/app_bg</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:colorBackground">@color/app_bg</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
